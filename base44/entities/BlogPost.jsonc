{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "title_fa": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "excerpt_fa": {
      "type": "string"
    },
    "excerpt_en": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Full article body (markdown or html)"
    },
    "date_fa": {
      "type": "string"
    },
    "date_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "news, education, etc."
    },
    "image": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "slug",
    "title_fa",
    "title_en",
    "image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}