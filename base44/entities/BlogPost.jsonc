{
  "name": "BlogPost",
  "type": "object",
  "title": "Blog Post",
  "description": "Blog posts with bilingual support (Persian / English)",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-friendly unique identifier"
    },
    "title_fa": {
      "type": "string",
      "description": "Title in Persian"
    },
    "title_en": {
      "type": "string",
      "description": "Title in English"
    },
    "excerpt_fa": {
      "type": "string",
      "description": "Short summary in Persian"
    },
    "excerpt_en": {
      "type": "string",
      "description": "Short summary in English"
    },
    "content": {
      "type": "string",
      "description": "Full article body (markdown or HTML)"
    },
    "date_fa": {
      "type": "string",
      "description": "Display date in Persian"
    },
    "date_en": {
      "type": "string",
      "description": "Display date in English"
    },
    "category": {
      "type": "string",
      "description": "Category (news, education, etc.)"
    },
    "image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Whether the post is publicly visible"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual sort order (lower = higher priority)"
    }
  },
  "required": [
    "slug",
    "title_fa",
    "title_en",
    "image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
