{
  "name": "Product",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier, e.g. hazelnut-paste"
    },
    "name_fa": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "desc_fa": {
      "type": "string"
    },
    "desc_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Category slug: hazelnut, pistachio, almond"
    },
    "origin_fa": {
      "type": "string"
    },
    "origin_en": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price in IRR per kg"
    },
    "price_display": {
      "type": "string",
      "description": "Pre-formatted Persian numeral price string"
    },
    "image": {
      "type": "string",
      "description": "Primary image URL"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional image URLs"
    },
    "badge": {
      "type": "string",
      "description": "Persian badge label, null if none"
    },
    "badge_en": {
      "type": "string",
      "description": "English badge label, null if none"
    },
    "taste": {
      "type": "object",
      "properties": {
        "bitter": {
          "type": "number"
        },
        "sweet": {
          "type": "number"
        },
        "earthy": {
          "type": "number"
        },
        "nutty": {
          "type": "number"
        }
      },
      "description": "Taste profile percentages 0-100"
    },
    "weights": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Available weights in grams"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Whether the product is visible on the public storefront"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "slug",
    "name_fa",
    "name_en",
    "price",
    "image",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}