{
  "name": "GalleryImage",
  "type": "object",
  "properties": {
    "title_fa": {
      "type": "string",
      "description": "Persian title for the gallery image"
    },
    "title_en": {
      "type": "string",
      "description": "English title for the gallery image"
    },
    "desc_fa": {
      "type": "string",
      "description": "Persian caption/description"
    },
    "desc_en": {
      "type": "string",
      "description": "English caption/description"
    },
    "image": {
      "type": "string",
      "description": "Image URL"
    },
    "span": {
      "type": "string",
      "enum": [
        "tall",
        "wide",
        "normal"
      ],
      "default": "normal",
      "description": "Masonry layout sizing hint"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title_fa",
    "title_en",
    "image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}