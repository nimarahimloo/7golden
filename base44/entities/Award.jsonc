{
  "name": "Award",
  "type": "object",
  "properties": {
    "title_fa": {
      "type": "string",
      "description": "Persian title of license/award"
    },
    "title_en": {
      "type": "string",
      "description": "English title of license/award"
    },
    "desc_fa": {
      "type": "string",
      "description": "Persian description"
    },
    "desc_en": {
      "type": "string",
      "description": "English description"
    },
    "image": {
      "type": "string",
      "description": "Image URL of the license/award"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title_fa",
    "title_en",
    "image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}